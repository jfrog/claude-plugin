{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/agent-hooks/claude-session-start.mjs\" package-guard",
            "timeout": 7,
            "statusMessage": "Routing package installs through JFrog Artifactory…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/inject-instructions.mjs\"",
            "timeout": 7
          }
        ]
      }
    ]
  }
}
