{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/modules/claude-session-start.mjs",
              "package-resolution"
            ],
            "timeout": 7,
            "statusMessage": "Routing package installs through JFrog Artifactory…"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/modules/claude-align-plugin-mcps.mjs",
              "session-start"
            ],
            "timeout": 45,
            "statusMessage": "Aligning plugin MCPs with JFrog Agent Guard…"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "installed_plugins.json|known_marketplaces.json",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/modules/claude-align-plugin-mcps.mjs",
              "file-changed"
            ],
            "timeout": 45,
            "statusMessage": "Re-aligning plugin MCPs…"
          }
        ]
      }
    ]
  }
}
